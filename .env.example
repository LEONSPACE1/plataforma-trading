# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Finnhub (gratis): https://finnhub.io/register > Dashboard > API Key
# Opcional: sin ella, las acciones de EE. UU. salen de Yahoo con retraso.
FINNHUB_API_KEY=

# --- Alertas (paso 4); guía en la carpeta del proyecto: guias/alertas-portafolio.md ---
# Supabase: Project Settings > API Keys > service_role (secreta, solo servidor).
SUPABASE_SERVICE_ROLE_KEY=
# Texto largo al azar; el mismo va en supabase/cron_alertas.sql.
CRON_SECRET=
# Claves para notificaciones push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Token del bot que crea @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=
